---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Layout title="Johan Alcalá">
	<header>
		<p class="prompt">guest@jalcalaroot:~$ whoami</p>
		<h1>Johan Alcalá<span class="cursor">_</span></h1>
		<p class="tagline">
			Senior Cloud Architect | Multicloud (AWS &amp; Azure) | Security,
			DevSecOps &amp; AI-Driven Cloud Solutions
		</p>
		<p class="links">
			<a href="https://github.com/jalcalaroot">GitHub</a>
			<span aria-hidden="true">·</span>
			<a href="https://www.linkedin.com/in/johan-a-3b582270/">LinkedIn</a>
			<span aria-hidden="true">·</span>
			<span class="email">johanalcala104@gmail.com</span>
		</p>
	</header>

	<section>
		<p>
			Diseño y opero infraestructura en la nube a nivel arquitectura —
			multicloud (Azure y AWS), redes, cómputo y bases de datos como código
			con Terraform y Kubernetes. Me enfoco en que esa infraestructura sea
			segura por diseño: DevSecOps integrado al pipeline, no como un paso
			aparte, y cada vez más apoyado en IA para acelerar el diseño, la
			detección de problemas y la toma de decisiones en arquitecturas cloud.
		</p>
	</section>

	<section>
		<h2>Stack</h2>
		<ul class="skills">
			<li class="tag">Azure</li>
			<li class="tag">AWS</li>
			<li class="tag">Terraform</li>
			<li class="tag">Kubernetes</li>
			<li class="tag">DevSecOps</li>
			<li class="tag">Seguridad Cloud</li>
			<li class="tag">CI/CD</li>
			<li class="tag">IA aplicada a Cloud</li>
			<li class="tag">Networking / IaC</li>
		</ul>
	</section>

	<section>
		<h2>Proyectos</h2>
		<ul class="project-list">
			<li>
				<a href="https://github.com/jalcalaroot/azure-virtual-network">azure-virtual-network</a>
				<p>
					Capa de red en Azure — VNet, subnets por tier, NSGs, Key Vault y
					Storage Account tras Private Endpoints, como Terraform IaC.
				</p>
			</li>
			<li>
				<a href="https://github.com/jalcalaroot/azure-tfstate-bootstrap">azure-tfstate-bootstrap</a>
				<p>Bootstrap del backend remoto de Terraform state en Azure Blob Storage.</p>
			</li>
			<li>
				<a href="https://github.com/jalcalaroot/azure-jumpbox-server">azure-jumpbox-server</a>
				<p>Servidor jumpbox/bastion desplegado en la subnet de aplicación.</p>
			</li>
		</ul>
	</section>

	{
		posts.length > 0 && (
			<section>
				<h2>Últimos posts</h2>
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('es', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
									timeZone: 'UTC',
								})}
							</time>
						</li>
					))}
				</ul>
				<a href="/blog/">Ver todos los posts →</a>
			</section>
		)
	}

	<footer>&copy; {new Date().getFullYear()} Johan Alcalá</footer>
</Layout>

<style>
	header {
		margin-bottom: 3rem;
	}

	.prompt {
		color: var(--text-muted);
		font-size: 0.875rem;
		margin: 0 0 0.5rem;
	}

	h1 {
		font-size: 2rem;
		margin: 0 0 0.25rem;
	}

	.cursor {
		display: inline-block;
		animation: blink 1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.tagline {
		font-size: 1rem;
		line-height: 1.5;
		color: var(--text-muted);
		margin: 0 0 1rem;
	}

	.links {
		font-size: 0.95rem;
	}

	.links span {
		color: var(--border);
		margin: 0 0.5rem;
	}

	.links .email {
		color: var(--text);
		margin: 0;
	}

	section {
		margin-bottom: 2.5rem;
	}

	h2 {
		font-size: 1.25rem;
		margin-bottom: 1rem;
	}

	.post-list {
		list-style: none;
		padding: 0;
		margin: 0 0 1rem;
	}

	.post-list li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--border);
	}

	.post-list time {
		color: var(--text-muted);
		font-size: 0.875rem;
		white-space: nowrap;
	}

	.skills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.tag {
		font-size: 0.85rem;
		color: var(--text);
		border: 1px solid var(--border);
		background: var(--bg-subtle);
		border-radius: 4px;
		padding: 0.3rem 0.7rem;
	}

	.project-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.project-list li {
		padding: 0.8rem 0;
		border-bottom: 1px solid var(--border);
	}

	.project-list li:last-child {
		border-bottom: none;
	}

	.project-list a {
		font-weight: 700;
	}

	.project-list p {
		margin: 0.35rem 0 0;
		color: var(--text-muted);
		font-size: 0.95rem;
	}
</style>
