---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Layout title="Johan Alcalá">
	<header>
		<p class="prompt">guest@jalcalaroot:~$ whoami</p>
		<h1>Johan Alcalá<span class="cursor">_</span></h1>
		<p class="tagline">
			Senior Cloud Architect | Multicloud (AWS &amp; Azure) | Security,
			DevSecOps &amp; AI-Driven Cloud Solutions
		</p>
		<p class="links">
			<a href="https://github.com/jalcalaroot">GitHub</a>
			<span aria-hidden="true">·</span>
			<a href="https://www.linkedin.com/in/johan-a-3b582270/">LinkedIn</a>
			<span aria-hidden="true">·</span>
			<span class="email">johanalcala104@gmail.com</span>
		</p>
	</header>

	<section>
		<p>
			I design and operate cloud infrastructure at the architecture level —
			multicloud (Azure and AWS), networking, compute, and databases as code
			with Terraform and Kubernetes. I focus on making that infrastructure
			secure by design: DevSecOps built into the pipeline, not bolted on
			afterward, and increasingly powered by AI to speed up design, catch
			issues earlier, and support decision-making in cloud architecture.
		</p>
	</section>

	<section>
		<h2>Stack</h2>
		<ul class="skills">
			<li class="tag">Azure</li>
			<li class="tag">AWS</li>
			<li class="tag">Terraform</li>
			<li class="tag">Kubernetes</li>
			<li class="tag">DevSecOps</li>
			<li class="tag">Cloud Security</li>
			<li class="tag">CI/CD</li>
			<li class="tag">AI for Cloud</li>
			<li class="tag">Networking / IaC</li>
		</ul>
	</section>

	<section>
		<h2>Projects</h2>
		<ul class="project-list">
			<li>
				<a href="https://github.com/jalcalaroot/azure-virtual-network">azure-virtual-network</a>
				<p>
					Azure network layer — VNet, per-tier subnets, NSGs, Key Vault and
					Storage Account behind Private Endpoints, as Terraform IaC.
				</p>
			</li>
			<li>
				<a href="https://github.com/jalcalaroot/azure-lb-webserver">azure-lb-webserver</a>
				<p>
					Public Application Gateway (L7, multi-AZ) load balancing Nginx VMs
					across availability zones.
				</p>
			</li>
			<li>
				<a href="https://github.com/jalcalaroot/azure-jumpbox-server">azure-jumpbox-server</a>
				<p>Jumpbox/bastion server deployed into the app subnet.</p>
			</li>
			<li>
				<a href="https://github.com/jalcalaroot/eks-fargate-cloudformation">eks-fargate-cloudformation</a>
				<p>Serverless EKS cluster on Fargate, provisioned with CloudFormation.</p>
			</li>
			<li>
				<a href="https://github.com/jalcalaroot/gateway-load-balancer-demo-cloudformation">gateway-load-balancer-demo-cloudformation</a>
				<p>
					Multi-AZ VPC with Transit Gateway and Gateway Load Balancer routing
					traffic through firewall appliances.
				</p>
			</li>
			<li>
				<a href="https://github.com/jalcalaroot/infraestructura-aws">infraestructura-aws</a>
				<p>
					Modular CloudFormation IaC (VPC, bastion host, Directory Service,
					WorkSpaces) with GitHub Actions CI/CD, Checkov, and Infracost.
				</p>
			</li>
		</ul>
	</section>

	{
		posts.length > 0 && (
			<section>
				<h2>Latest posts</h2>
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
									timeZone: 'UTC',
								})}
							</time>
						</li>
					))}
				</ul>
				<a href="/blog/">View all posts →</a>
			</section>
		)
	}

	<footer>&copy; {new Date().getFullYear()} Johan Alcalá</footer>
</Layout>

<style>
	header {
		margin-bottom: 3rem;
	}

	.prompt {
		color: var(--text-muted);
		font-size: 0.875rem;
		margin: 0 0 0.5rem;
	}

	h1 {
		font-size: 2rem;
		margin: 0 0 0.25rem;
	}

	.cursor {
		display: inline-block;
		animation: blink 1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.tagline {
		font-size: 1rem;
		line-height: 1.5;
		color: var(--text-muted);
		margin: 0 0 1rem;
	}

	.links {
		font-size: 0.95rem;
	}

	.links span {
		color: var(--border);
		margin: 0 0.5rem;
	}

	.links .email {
		color: var(--text);
		margin: 0;
	}

	section {
		margin-bottom: 2.5rem;
	}

	h2 {
		font-size: 1.25rem;
		margin-bottom: 1rem;
	}

	.post-list {
		list-style: none;
		padding: 0;
		margin: 0 0 1rem;
	}

	.post-list li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--border);
	}

	.post-list time {
		color: var(--text-muted);
		font-size: 0.875rem;
		white-space: nowrap;
	}

	.skills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.tag {
		font-size: 0.85rem;
		color: var(--text);
		border: 1px solid var(--border);
		background: var(--bg-subtle);
		border-radius: 4px;
		padding: 0.3rem 0.7rem;
	}

	.project-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.project-list li {
		padding: 0.8rem 0;
		border-bottom: 1px solid var(--border);
	}

	.project-list li:last-child {
		border-bottom: none;
	}

	.project-list a {
		font-weight: 700;
	}

	.project-list p {
		margin: 0.35rem 0 0;
		color: var(--text-muted);
		font-size: 0.95rem;
	}
</style>
