---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog — Johan Alcalá">
	<nav class="nav">
		<a href="/">← Inicio</a>
	</nav>

	<h1>Blog</h1>

	<ul class="post-list">
		{
			posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>{post.data.title}</a>
					<p>{post.data.description}</p>
					<time datetime={post.data.pubDate.toISOString()}>
						{post.data.pubDate.toLocaleDateString('es', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
							timeZone: 'UTC',
						})}
					</time>
				</li>
			))
		}
	</ul>
</Layout>

<style>
	.post-list {
		list-style: none;
		padding: 0;
		margin: 2rem 0;
	}

	.post-list li {
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--border);
	}

	.post-list a {
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--text);
	}

	.post-list a:hover {
		color: var(--accent);
	}

	.post-list p {
		margin: 0.4rem 0;
		color: var(--text-muted);
	}

	.post-list time {
		font-size: 0.875rem;
		color: var(--text-muted);
	}
</style>
